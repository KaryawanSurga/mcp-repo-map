{
  "name": "mcp-repo-map",
  "version": "0.1.0",
  "description": "MCP server and CLI that map a repository for AI agents — structure, languages, symbols, imports, dependents, and recent changes without reading every file.",
  "type": "module",
  "license": "MIT",
  "author": "KaryawanSurga",
  "homepage": "https://github.com/KaryawanSurga/mcp-repo-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaryawanSurga/mcp-repo-map.git"
  },
  "bugs": {
    "url": "https://github.com/KaryawanSurga/mcp-repo-map/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "repo-map",
    "code-navigation",
    "symbols",
    "imports",
    "ai-agents",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-repo-map": "dist/index.js",
    "repomap": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
